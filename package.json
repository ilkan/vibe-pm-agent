{
  "name": "vibe-pm-agent",
  "version": "2.0.0",
  "description": "Evidence-backed business intelligence MCP server - Kiro's missing PM Mode that transforms raw ideas into comprehensive business cases with professional citations and confidence scoring",
  "main": "dist/mcp/server.js",
  "bin": {
    "mcp-server": "./bin/mcp-server.js",
    "vibe-pm-agent": "./bin/mcp-server.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.prod.json",
    "build:dev": "tsc --project tsconfig.dev.json --incremental",
    "build:prod": "tsc --project tsconfig.prod.json",
    "build:mcp": "tsc --project tsconfig.mcp.json",
    "start": "node dist/mcp/server.js",
    "test": "jest --passWithNoTests --maxWorkers=2 --testTimeout=60000",
    "test:unit": "jest --testPathPattern=unit --passWithNoTests --maxWorkers=2 --testTimeout=60000",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests --maxWorkers=1 --testTimeout=120000",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "type-check:prod": "tsc --project tsconfig.prod.json --noEmit",
    "mcp:server": "node dist/mcp/server.js",
    "mcp:server:debug": "node dist/mcp/server.js --log-level debug",
    "clean": "rm -rf dist",
    "clean:prod": "rm -rf dist && npm run build:prod",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run clean:prod && npm run test",
    "build:analyze": "npm run build:prod && npm run analyze:bundle",
    "analyze:bundle": "find dist -name '*.js' -exec wc -c {} + | sort -n",
    "verify:production": "node scripts/verify-production-build.mjs",
    "start:verify": "timeout 10s node dist/mcp/server.js --health || true",
    "demo:hackathon": "node demo/hackathon-showcase.js",
    "demo:ui": "node demo/serve-demo.js",
    "demo:aws-agents": "node demo/aws-agent-orchestration.js",
    "demo:multi-agent-orchestration": "node demo/multi-agent-demo.js",
    "demo:nova-pro-capabilities": "node demo/nova-pro-demo.js",
    "demo:nova-pro": "node demo/nova-pro-demo.js",
    "demo:aws-architecture": "node demo/aws-architecture-demo.js",
    "show:impact-metrics": "node demo/impact-metrics-display.js",
    "test:bedrock-agent": "node tests/aws/bedrock-agent-test.js",
    "test:nova-model": "node tests/aws/nova-model-test.js",
    "test:mcp-complete": "npm run test && node tests/mcp/complete-integration-test.js",
    "test:aws-integration": "node tests/aws/integration-test.js",
    "deploy:aws": "bash deployment/aws/deploy-bedrock-agent.sh",
    "deploy:lambda": "sam deploy --template-file aws-template.yaml",
    "setup:knowledge-base": "node scripts/setup-bedrock-knowledge-base.js",
    "health:aws": "node scripts/aws-health-check.js",
    "analytics:aws": "node scripts/aws-analytics.js",
    "benchmark:aws": "node tests/performance/aws-benchmark.js",
    "validate:hackathon": "node scripts/hackathon-validation.js"
  },
  "keywords": [
    "aws-agent-hackathon",
    "amazon-bedrock-agent",
    "amazon-nova-pro",
    "aws-ai-services",
    "mcp",
    "model-context-protocol",
    "kiro",
    "business-intelligence",
    "pm-interview-coaching",
    "product-management",
    "executive-communications",
    "ai-powered-analysis",
    "serverless-architecture",
    "multi-agent-system",
    "strategic-planning",
    "consulting-frameworks",
    "evidence-based-analysis",
    "confidence-scoring",
    "competitive-intelligence"
  ],
  "author": "Vibe PM Agent Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ilkan/vibe-pm-agent.git"
  },
  "bugs": {
    "url": "https://github.com/ilkan/vibe-pm-agent/issues"
  },
  "homepage": "https://github.com/ilkan/vibe-pm-agent#readme",
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.20.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {

    "@aws-sdk/util-dynamodb": "^3.908.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "kiro": "*"
  },
  "files": [
    "dist/",
    "bin/",
    "docs/MCP_TOOLS_REFERENCE.md",
    "docs/BUSINESS_INTELLIGENCE_GUIDE.md",
    "docs/CITATION_SYSTEM_GUIDE.md",
    "docs/EXECUTIVE_COMMUNICATIONS.md",
    "examples/mcp-client-config.json",
    "examples/mcp-client-complete-config.json",
    "examples/server-config.json",
    "examples/production-deployment/",
    "README.md",
    "LICENSE"
  ]
}
