{
  "name": "vibe-pm-agent",
  "version": "2.0.0",
  "description": "Evidence-backed business intelligence MCP server - Kiro's missing PM Mode that transforms raw ideas into comprehensive business cases with professional citations and confidence scoring",
  "main": "dist/mcp/server.js",
  "bin": {
    "mcp-server": "./bin/mcp-server.js",
    "vibe-pm-agent": "./bin/mcp-server.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.prod.json",
    "build:dev": "tsc --project tsconfig.dev.json --incremental",
    "build:prod": "tsc --project tsconfig.prod.json",
    "build:mcp": "tsc --project tsconfig.mcp.json",
    "start": "node dist/mcp/server.js",
    "test": "jest --passWithNoTests --maxWorkers=2 --testTimeout=60000",
    "test:unit": "jest --testPathPattern=unit --passWithNoTests --maxWorkers=2 --testTimeout=60000",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests --maxWorkers=1 --testTimeout=120000",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "type-check:prod": "tsc --project tsconfig.prod.json --noEmit",
    "mcp:server": "node dist/mcp/server.js",
    "mcp:server:debug": "node dist/mcp/server.js --log-level debug",
    "clean": "rm -rf dist",
    "clean:prod": "rm -rf dist && npm run build:prod",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run clean:prod && npm run test",
    "build:analyze": "npm run build:prod && npm run analyze:bundle",
    "analyze:bundle": "find dist -name '*.js' -exec wc -c {} + | sort -n",
    "verify:production": "node scripts/verify-production-build.mjs",
    "start:verify": "timeout 10s node dist/mcp/server.js --health || true",
    "deploy:aws": "cd deployment/aws && ./deploy.sh",
    "deploy:aws:dev": "cd deployment/aws && STAGE=dev ./deploy.sh",
    "deploy:aws:staging": "cd deployment/aws && STAGE=staging ./deploy.sh",
    "deploy:aws:prod": "cd deployment/aws && STAGE=prod ./deploy.sh",
    "deploy:aws:remove": "cd deployment/aws && ./deploy.sh remove",
    "deploy:aws:info": "cd deployment/aws && ./deploy.sh info",
    "deploy:aws:logs": "cd deployment/aws && ./deploy.sh logs",
    "deploy:aws:test": "cd deployment/aws && ./deploy.sh test",
    "deploy:verify": "node deployment/aws/verify-deployment.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kiro",
    "business-intelligence",
    "product-management",
    "executive-communications",
    "market-analysis",
    "roi-analysis",
    "strategic-planning",
    "consulting-frameworks",
    "evidence-based-analysis",
    "citation-management",
    "confidence-scoring",
    "competitive-intelligence",
    "pm-documents"
  ],
  "author": "Vibe PM Agent Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ilkan/vibe-pm-agent.git"
  },
  "bugs": {
    "url": "https://github.com/ilkan/vibe-pm-agent/issues"
  },
  "homepage": "https://github.com/ilkan/vibe-pm-agent#readme",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.157",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.0.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "aws-xray-sdk-core": "^3.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "kiro": "*"
  },
  "files": [
    "dist/",
    "bin/",
    "docs/MCP_TOOLS_REFERENCE.md",
    "docs/BUSINESS_INTELLIGENCE_GUIDE.md",
    "docs/CITATION_SYSTEM_GUIDE.md",
    "docs/EXECUTIVE_COMMUNICATIONS.md",
    "examples/mcp-client-config.json",
    "examples/mcp-client-complete-config.json",
    "examples/server-config.json",
    "examples/production-deployment/",
    "README.md",
    "LICENSE"
  ]
}
