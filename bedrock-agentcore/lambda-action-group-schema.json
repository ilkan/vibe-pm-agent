          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idea": {
                    "type": "string",
                    "description": "The business or feature idea to analyze"
                  },
                  "market_context": {
                    "type": "object",
                    "properties": {
                      "industry": { "type": "string" },
                      "competition": { "type": "string" },
                      "budget_range": { "type": "string", "enum": ["small", "medium", "large"] },
                      "timeline": { "type": "string" }
                    }
                  }
                },
                "required": ["idea"]
