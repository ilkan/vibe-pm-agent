          "200": {
            "description": "Business opportunity analysis completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "analysis": { "type": "string" },
                    "recommendations": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
