#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hooks for code quality and resource cleanup

echo "🔍 Running pre-commit checks..."

# 1. Lint and format check
echo "📝 Checking code formatting and linting..."
npm run lint:check || {
  echo "❌ Linting failed. Run 'npm run lint:fix' to fix issues."
  exit 1
}

npm run format:check || {
  echo "❌ Code formatting check failed. Run 'npm run format' to fix formatting."
  exit 1
}

# 2. Type checking
echo "🔍 Running TypeScript type checking..."
npm run type-check || {
  echo "❌ Type checking failed. Fix TypeScript errors before committing."
  exit 1
}

# 3. Clean up any test artifacts
echo "🧹 Cleaning up test artifacts..."
npm run cleanup || true

# 4. Run quick resource leak detection
echo "🔍 Running resource leak detection..."
npm test -- --testNamePattern="should create and destroy cache" --maxWorkers=1 --testTimeout=5000 --silent || {
  echo "❌ Resource leak detection failed. Check for timer cleanup issues."
  exit 1
}

# 5. Check for unused imports (basic check)
echo "🔍 Checking for potential unused imports..."
node scripts/pre-commit-cleanup.mjs || {
  echo "⚠️  Pre-commit cleanup script failed, but continuing..."
}

echo "✅ Pre-commit checks passed!"