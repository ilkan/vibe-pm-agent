{
  "name": "vibe-pm-agent-aws-deployment",
  "version": "1.0.0",
  "description": "AWS deployment configuration for Vibe PM Agent",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:staging": "serverless deploy --stage staging",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "info": "serverless info",
    "logs": "serverless logs -f mcpServer -t",
    "invoke": "serverless invoke -f mcpServer",
    "offline": "serverless offline",
    "package": "serverless package",
    "build": "cd ../.. && npm run build:prod",
    "prebuild": "cd ../.. && npm run clean",
    "predeploy": "npm run build"
  },
  "devDependencies": {
    "serverless": "^3.40.0",
    "serverless-offline": "^13.3.0",
    "serverless-plugin-tracing": "^2.0.0",
    "serverless-prune-plugin": "^2.0.2",
    "serverless-webpack": "^5.13.0",
    "ts-loader": "^9.5.1",
    "webpack": "^5.89.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.0.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "vibe-pm-agent",
    "mcp"
  ],
  "author": "Vibe PM Agent Team",
  "license": "MIT"
}
