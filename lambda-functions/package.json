{
  "name": "vibe-pm-agent-lambda-functions",
  "version": "2.0.0",
  "description": "AWS Lambda functions for Vibe PM Agent - wrapping 32 PM-focused tools",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:dev": "tsc --project tsconfig.dev.json",
    "build:prod": "tsc --project tsconfig.prod.json",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:lambda": "node test-lambda.js",
    "test:lambda:health": "node test-lambda.js health",
    "test:lambda:all": "./test-lambda.sh all",
    "test:external": "node test-external-api-access.js",
    "test:api-keys": "node test-api-key-validation.js",
    "test:internal": "node test-internal-access.js",
    "test:environment": "node test-environment-config.js",
    "test:dual-access": "node test-dual-access.js",
    "test:all-access": "npm run test:api-keys && npm run test:internal && npm run test:environment",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "package": "npm run build:prod && cd dist && zip -r ../lambda-functions.zip .",
    "deploy:dev": "npm run package && aws lambda update-function-code --function-name vibe-pm-agent-dev --zip-file fileb://lambda-functions.zip",
    "deploy:prod": "npm run package && aws lambda update-function-code --function-name vibe-pm-agent-prod --zip-file fileb://lambda-functions.zip"
  },
  "keywords": [
    "aws-lambda",
    "typescript",
    "pm-tools",
    "business-intelligence",
    "mcp-server",
    "bedrock-agent"
  ],
  "author": "Vibe PM Agent Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.490.0",
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/client-lambda": "^3.490.0",
    "@aws-sdk/util-dynamodb": "^3.490.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
