{
  "mcpServers": {
    "vibe-pm-agent": {
      "command": "npx",
      "args": ["vibe-pm-agent"],
      "env": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "ENABLE_HEALTH_CHECK": "true",
        "MCP_SERVER_PORT": "3001",
        "MAX_CONCURRENT_REQUESTS": "15",
        "REQUEST_TIMEOUT_MS": "30000",
        "CACHE_ENABLED": "true",
        "CACHE_TTL_MS": "300000",
        "KIRO_INTEGRATION_MODE": "true",
        "STEERING_FILES_ENABLED": "true",
        "ENABLE_CITATIONS": "true",
        "MIN_CITATION_CONFIDENCE": "medium",
        "DEFAULT_CITATION_STYLE": "business",
        "ENABLE_COMPETITIVE_ANALYSIS": "true",
        "ENABLE_MARKET_SIZING": "true"
      },
      "disabled": false,
      "description": "Optimized configuration for Kiro IDE integration with PM Mode capabilities",
      "autoApprove": [
        "validate_idea_quick",
        "optimize_intent",
        "analyze_workflow",
        "generate_roi_analysis",
        "get_consulting_summary",
        "generate_requirements",
        "generate_design_options",
        "generate_task_plan",
        "generate_management_onepager",
        "generate_pr_faq",
        "analyze_business_opportunity",
        "generate_business_case",
        "create_stakeholder_communication",
        "assess_strategic_alignment",
        "optimize_resource_allocation",
        "validate_market_timing",
        "enhance_citations",
        "validate_and_audit_citations",
        "monitor_market_conditions",
        "analyze_competitor_landscape",
        "calculate_market_sizing"
      ]
    }
  }
}