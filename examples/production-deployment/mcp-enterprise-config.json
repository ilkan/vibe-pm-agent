{
  "mcpServers": {
    "vibe-pm-agent": {
      "command": "npx",
      "args": ["vibe-pm-agent"],
      "env": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "ENABLE_HEALTH_CHECK": "true",
        "MCP_SERVER_PORT": "3001",
        "MAX_CONCURRENT_REQUESTS": "20",
        "REQUEST_TIMEOUT_MS": "45000",
        "CACHE_ENABLED": "true",
        "CACHE_TTL_MS": "600000",
        "MAX_CACHE_SIZE": "200",
        "ENABLE_RATE_LIMITING": "true",
        "MAX_REQUESTS_PER_MINUTE": "120",
        "ENABLE_INPUT_SANITIZATION": "true",
        "ENABLE_METRICS": "true",
        "ENABLE_CITATIONS": "true",
        "MIN_CITATION_CONFIDENCE": "high",
        "MAX_CITATION_AGE_MONTHS": "12",
        "ENABLE_COMPETITIVE_ANALYSIS": "true",
        "ENABLE_MARKET_SIZING": "true",
        "KIRO_INTEGRATION_MODE": "true",
        "STEERING_FILES_ENABLED": "true",
        "DEFAULT_CITATION_STYLE": "business"
      },
      "disabled": false,
      "description": "Enterprise deployment with full business intelligence capabilities, enhanced security, and performance optimization",
      "autoApprove": [
        "validate_idea_quick",
        "optimize_intent",
        "analyze_workflow",
        "generate_roi_analysis",
        "get_consulting_summary",
        "analyze_business_opportunity",
        "validate_market_timing",
        "analyze_competitor_landscape",
        "calculate_market_sizing"
      ]
    }
  }
}