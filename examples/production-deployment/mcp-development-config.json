{
  "mcpServers": {
    "vibe-pm-agent": {
      "command": "npx",
      "args": ["vibe-pm-agent"],
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "ENABLE_HEALTH_CHECK": "true",
        "MCP_SERVER_PORT": "3001",
        "MAX_CONCURRENT_REQUESTS": "5",
        "REQUEST_TIMEOUT_MS": "60000",
        "CACHE_ENABLED": "false",
        "ENABLE_RATE_LIMITING": "false",
        "ENABLE_INPUT_SANITIZATION": "true",
        "ENABLE_METRICS": "true",
        "ENABLE_CITATIONS": "true",
        "MIN_CITATION_CONFIDENCE": "low",
        "MAX_CITATION_AGE_MONTHS": "24",
        "ENABLE_COMPETITIVE_ANALYSIS": "true",
        "ENABLE_MARKET_SIZING": "true",
        "KIRO_INTEGRATION_MODE": "true",
        "STEERING_FILES_ENABLED": "true",
        "DEFAULT_CITATION_STYLE": "business",
        "DEBUG_MODE": "true",
        "ENABLE_PROFILING": "true"
      },
      "disabled": false,
      "description": "Development configuration with debug logging and extended timeouts for testing",
      "autoApprove": []
    }
  }
}