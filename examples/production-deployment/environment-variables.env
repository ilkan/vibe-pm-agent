# Vibe PM Agent - Production Environment Variables
# Copy this file to .env and customize for your deployment

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Environment mode (development, production, test)
NODE_ENV=production

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Server host and port for health checks
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3001

# =============================================================================
# PERFORMANCE & SCALING
# =============================================================================

# Maximum number of concurrent tool requests
MAX_CONCURRENT_REQUESTS=10

# Request timeout in milliseconds (30 seconds)
REQUEST_TIMEOUT_MS=30000

# Enable response caching for better performance
CACHE_ENABLED=true

# Cache time-to-live in milliseconds (5 minutes)
CACHE_TTL_MS=300000

# Maximum number of cache entries
MAX_CACHE_SIZE=100

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================

# Enable rate limiting (recommended for production)
ENABLE_RATE_LIMITING=false

# Maximum requests per minute per client
MAX_REQUESTS_PER_MINUTE=60

# Enable input sanitization (recommended)
ENABLE_INPUT_SANITIZATION=true

# CORS allowed origins (comma-separated, * for all)
ALLOWED_ORIGINS=*

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================

# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Health check endpoint path
HEALTH_CHECK_PATH=/health

# Enable performance metrics collection
ENABLE_METRICS=true

# Metrics collection interval in milliseconds (1 minute)
METRICS_COLLECTION_INTERVAL=60000

# =============================================================================
# BUSINESS INTELLIGENCE FEATURES
# =============================================================================

# Enable citation system for business analysis
ENABLE_CITATIONS=true

# Minimum citation confidence level (low, medium, high)
MIN_CITATION_CONFIDENCE=high

# Maximum citation age in months
MAX_CITATION_AGE_MONTHS=18

# Enable competitive analysis tools
ENABLE_COMPETITIVE_ANALYSIS=true

# Enable market sizing tools
ENABLE_MARKET_SIZING=true

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================

# Enable Kiro-specific optimizations
KIRO_INTEGRATION_MODE=true

# Comma-separated list of auto-approved tools (no  prefix)
AUTO_APPROVE_TOOLS=validate_idea_quick,optimize_intent,analyze_workflow,get_consulting_summary

# Enable steering file generation
STEERING_FILES_ENABLED=true

# Default citation style (business, apa, inline)
DEFAULT_CITATION_STYLE=business

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Enable profiling for performance analysis (development only)
ENABLE_PROFILING=false

# Maximum response time threshold in milliseconds
MAX_RESPONSE_TIME=10000

# Memory usage threshold in MB
MEMORY_THRESHOLD=512

# Enable debug mode for troubleshooting
DEBUG_MODE=false

# Custom data directory path (optional)
# DATA_DIRECTORY=/path/to/custom/data

# Custom log directory path (optional)
# LOG_DIRECTORY=/path/to/custom/logs