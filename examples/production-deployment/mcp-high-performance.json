{
  "mcpServers": {
    "vibe-pm-agent": {
      "command": "npx",
      "args": ["vibe-pm-agent"],
      "env": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "warn",
        "ENABLE_HEALTH_CHECK": "true",
        "MCP_SERVER_PORT": "3001",
        "MAX_CONCURRENT_REQUESTS": "25",
        "REQUEST_TIMEOUT_MS": "20000",
        "CACHE_ENABLED": "true",
        "CACHE_TTL_MS": "900000",
        "MAX_CACHE_SIZE": "500",
        "ENABLE_RATE_LIMITING": "true",
        "MAX_REQUESTS_PER_MINUTE": "200",
        "ENABLE_INPUT_SANITIZATION": "true",
        "ENABLE_METRICS": "true",
        "METRICS_COLLECTION_INTERVAL": "30000",
        "ENABLE_CITATIONS": "true",
        "MIN_CITATION_CONFIDENCE": "medium",
        "MAX_CITATION_AGE_MONTHS": "12",
        "ENABLE_COMPETITIVE_ANALYSIS": "true",
        "ENABLE_MARKET_SIZING": "true",
        "KIRO_INTEGRATION_MODE": "true",
        "STEERING_FILES_ENABLED": "true",
        "DEFAULT_CITATION_STYLE": "business",
        "MAX_RESPONSE_TIME": "15000",
        "MEMORY_THRESHOLD": "1024"
      },
      "disabled": false,
      "description": "High-performance configuration optimized for heavy workloads and fast response times",
      "autoApprove": [
        "validate_idea_quick",
        "optimize_intent",
        "analyze_workflow",
        "generate_roi_analysis",
        "get_consulting_summary",
        "analyze_business_opportunity",
        "validate_market_timing",
        "analyze_competitor_landscape",
        "calculate_market_sizing",
        "generate_business_case",
        "create_stakeholder_communication",
        "assess_strategic_alignment",
        "optimize_resource_allocation"
      ]
    }
  }
}