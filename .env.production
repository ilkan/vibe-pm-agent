# Production Environment Configuration for Vibe PM Agent MCP Server

# Node.js Environment
NODE_ENV=production

# MCP Server Configuration
MCP_LOG_LEVEL=WARN
MCP_ENABLE_LOGGING=true
MCP_ENABLE_METRICS=true
MCP_REQUEST_TIMEOUT=30000

# Performance Configuration
MCP_ENABLE_CACHING=true
MCP_MAX_CACHE_SIZE=1000
MCP_ENABLE_PERFORMANCE_LOGGING=false

# Security Configuration
MCP_ENABLE_INPUT_VALIDATION=true
MCP_ENABLE_OUTPUT_SANITIZATION=true
MCP_MAX_REQUEST_SIZE=10485760

# Disable development features
DISABLE_TIMERS=false
MOCK_MODE=false

# Production optimizations
MCP_PRODUCTION_MODE=true
MCP_STRICT_VALIDATION=true